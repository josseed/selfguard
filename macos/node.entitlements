<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundled Node.js runs with the hardened runtime and only this entitlement: V8 compiles
  JavaScript to machine code. Node's own release adds library validation off, unsigned
  executable memory, DYLD variables and get-task-allow (for native addons and debuggers);
  selfguard has no native code and none of those are needed.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
</dict>
</plist>
